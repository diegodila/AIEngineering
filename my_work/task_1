 def _validate_entry(
        self,
        entry: Dict[str, Any],
        passed_features:  Dict[str, Any]
    ) -> None:
        
        feature_groups_keys = [fg.primary_keys for fg in self.query.feature_groups]
        feature_groups_keys = [pk for pks in feature_groups_keys for pk in pks]
        
        missing_keys = [key for key in feature_groups_keys if key not in entry.keys()]
        if len(missing_keys) > 0:
            raise exceptions.FeatureViewError(f'Chaves primárias: {missing_keys} não encontrada(s) na Query.')
        
        unknown_keys = [key for key in entry.keys() if key not in feature_groups_keys]
        if len(unknown_keys) > 0:
            raise exceptions.FeatureViewError(f'Chaves primárias informadas: {unknown_keys} não encontrada(s) na Feature View.')
        
        feature_groups_features = list(itertools.chain.from_iterable(
            [fg.features for fg in self.query.feature_groups]))
        unknown_features = [f for f in passed_features.keys() if f not in feature_groups_features]
        if len(unknown_features) > 0:
            raise exceptions.FeatureViewError(f'Features informadas: {unknown_features} não encontrada(s) na Query.')
        

            
    def _fetch_features(self,entry) -> Dict[str, Any]:
