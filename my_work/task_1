    def get_feature_vector(
        self,
        entry: Dict[str, Any],
        passed_features: Optional[Dict[str, Any]]=None,
    ) -> List[Any]:
        """
        Recupera o vetor de features mais recente para uma única entidade.

        Destinado a integrações de inferência online (real-time serving),
        onde o modelo precisa das features mais atuais para uma entidade
        pontual.

        O método garante consistência de tipos com o dataset de treino,
        mitigando offline-online skew: as mesmas FeatureLookups usadas
        em get_training_data() são reutilizadas na busca online.

        Args:
            entry: Um dicionário de primary keys de feature group e seus
             valores informados pela aplicação.
            passed_features: Um dicionário de valores de features informados
             pela aplicação durante o momento de execução. Eles podem substituir
             valores de features vindos da feature store assim como gerar valores
             de features que não estão disponíveis na feature store.

        Returns:
            Retorna uma lista contendo valores de features relacionados a primary
             keys informadas, ordenadas de acordo com a posição das suas features
             na query da feature view.

        Raises:
            FeatureViewError: Quando as primary keys não forem encontradas nos
             features groups informados na feature view
             

        Example:
            >>> vetor = view.get_feature_vector(
            ...     entity_row={'id_cliente': 12345})
            >>> predicao = modelo.predict([list(vetor.values())])
        """
        feature_groups_keys = [fg.primary_keys for fg in self.query.feature_groups]
        feature_groups_keys = [pk for pks in feature_groups_keys for pk in pks]
        
        self._validate_entry(entry, passed_features)
        
        fetched_features = self._fetch_features(entry)
        features = {**entry,**fetched_features,**passed_features}
        return features
    
    def get_feature_vectors(
        self,
        entry: List[Dict[str, Any]],
        passed_features: Optional[List[Dict[str, Any]]]=None,
    ) -> List[List[Any]]:
        """
        Recupera os vetores de features mais recente para uma única entidade.

        Destinado a integrações de inferência online (real-time serving),
        onde o modelo precisa das features mais atuais para uma entidade
        pontual.

        O método garante consistência de tipos com o dataset de treino,
        mitigando offline-online skew: as mesmas FeatureLookups usadas
        em get_training_data() são reutilizadas na busca online.

        Args:
            entry: Uma lista de dicionário de primary keys 
                de feature group e seus valores informados pela aplicação.
            passed_features: Uma lista de dicionário de valores 
                de features informados pela aplicação durante o momento de execução. Eles podem     substituir valores de features vindos da feature store assim como gerar valores de features que não estão disponíveis na feature store.

        Returns:
            Retorna uma lista contendo valores de features 
                relacionados a primary keys informadas, ordenadas de acordo com a posição das suas features na query da feature view.
             

        Example:
            >>> vetors = view.get_feature_vectors(
            ...     entry=[{'id_cliente': 12345}, {'id': "Brasil"}])
            >>> predicao = modelo.predict([list(vetors.values())])
        """        
        features_list = []
        for idx in range(len(entry)):
            features_list.append(self.get_feature_vector(entry[idx], passed_features[idx]))
        return features_list
    
